# Padrões do Compose para as fixtures descartáveis do laboratório.
# Copie para .env. O Compose lê .env automaticamente.
# Para sobrescritas locais: docker compose --env-file .env --env-file .env.local ...

# Portas publicadas somente em 127.0.0.1; não alteram as portas entre containers.
REMOTE_DB_HOST_PORT=55432
LOCAL_DB_HOST_PORT=55433
MSSQL_HOST_PORT=51433
KAFKA_HOST_PORT=9092
TOXIPROXY_HOST_PORT=8474
KAFBAT_HOST_PORT=8080
ADMINER_HOST_PORT=8081
MONITOR_HOST_PORT=8082

# Credenciais administrativas das fixtures. Só inicializam volumes novos.
# As contas SELECT e suas senhas são provisionadas nos scripts SQL da fixture.
REMOTE_ADMIN_PASSWORD=lab-admin
LOCAL_ADMIN_PASSWORD=lab-admin
MONITOR_ADMIN_PASSWORD=monitor-admin
MSSQL_SA_PASSWORD='Lab-Strong-Pass-2026!'

# Rede interna Docker; localhost dentro do container é o próprio container.
KAFKA_BOOTSTRAP=kafka:19092
KAFKA_TOPIC=lab.sync.events
KAFKA_AUDIT_TOPIC=lab.sync.audit
TOXIPROXY_URL=http://toxiproxy:8474

# Reconciliação: SOURCE_SCHEMAS vazio descobre todos os schemas acessíveis.
SOURCE_SCHEMAS=
MAX_REMOVE_FRACTION=0.20
SCHEDULER_INTERVAL_SECONDS=60
INIT_PROMOTION_TIMEOUT_SECONDS=600

# Origem SQL Server opcional; porta do proxy na rede Docker.
MSSQL_HOST=toxiproxy
MSSQL_PORT=15433
MSSQL_USER=remote_reader
MSSQL_PASSWORD=lab-reader
MSSQL_DATABASE=lab_remote

# Monitor e coletor compartilham os mesmos limites e modo de visualização.
LAB_SYNC_MODE=catalog
LAB_STALLED_MINUTES=15
LAB_COVERAGE_WINDOW_HOURS=24
LAB_MAX_COVERAGE_INTERVALS=20000
LAB_EXPECTED_INTERVAL_MINUTES=0
LAB_MAX_CONSUMER_LAG=1000
LAB_MONITOR_COLLECTION_SECONDS=10
LAB_MONITOR_COLLECTION_MAX_AGE=60
