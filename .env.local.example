# Copie para .env.local e descomente apenas as sobrescritas desejadas.
# Este arquivo NÃO é lido automaticamente pelo Compose.
# Use os dois arquivos em todos os comandos da instância personalizada:
# docker compose --env-file .env --env-file .env.local up -d --build
# docker compose --env-file .env --env-file .env.local run --rm cli discover status

# Exemplos de portas alternativas no host:
# MONITOR_HOST_PORT=8182
# ADMINER_HOST_PORT=8181
# KAFBAT_HOST_PORT=8180
# KAFKA_HOST_PORT=19092

# Ajustes de leitura e agendamento:
# SOURCE_SCHEMAS=public
# SCHEDULER_INTERVAL_SECONDS=120
# MAX_REMOVE_FRACTION=0.20

# Senhas administrativas: precisam corresponder às senhas reais dos volumes.
# LOCAL_ADMIN_PASSWORD='senha-local'
# MSSQL_SA_PASSWORD='senha-sqlserver'

# DSNs opcionais da origem PostgreSQL (libpq), mantendo a conta SELECT.
# Os valores abaixo são os padrões da fixture, não endereços do host.
# REMOTE_DSN='host=toxiproxy port=15432 dbname=lab_remote user=remote_reader password=lab-reader connect_timeout=4'
# REMOTE_DIRECT_DSN='host=remote-db port=5432 dbname=lab_remote user=remote_reader password=lab-reader connect_timeout=4'
# O proxy remote_pg continua apontando para remote-db:5432; mudar somente
# REMOTE_DIRECT_DSN não altera esse upstream nem a conexão de extração.
